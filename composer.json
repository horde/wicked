{
    "name": "horde/wicked",
    "description": "Wiki application",
    "type": "horde-application",
    "homepage": "https://www.horde.org/apps/wicked",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2025-05-12",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^2",
        "php": "^7.4 || ^8",
        "horde/horde": "^6 || dev-FRAMEWORK_6_0",
        "horde/auth": "^3 || dev-FRAMEWORK_6_0",
        "horde/autoloader": "^3 || dev-FRAMEWORK_6_0",
        "horde/core": "^3 || dev-FRAMEWORK_6_0",
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/form": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "horde/lock": "^3 || dev-FRAMEWORK_6_0",
        "horde/mail": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime_viewer": "^3 || dev-FRAMEWORK_6_0",
        "horde/notification": "^3 || dev-FRAMEWORK_6_0",
        "horde/perms": "^3 || dev-FRAMEWORK_6_0",
        "horde/prefs": "^3 || dev-FRAMEWORK_6_0",
        "horde/rpc": "^3 || dev-FRAMEWORK_6_0",
        "horde/text_diff": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "horde/vfs": "^3 || dev-FRAMEWORK_6_0",
        "ext-gettext": "*"
    },
    "require-dev": {},
    "suggest": {
        "pear/text_figlet": "*",
        "horde/test": "* || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "exclude-from-classmap": [
            "lib/Text_Wiki/Text/Wiki/Parse/BBCode/",
            "lib/Text_Wiki/Text/Wiki/Parse/Doku/",
            "lib/Text_Wiki/Text/Wiki/Parse/Tiki/",
            "lib/Text_Wiki/Text/Wiki/Parse/Creole/",
            "lib/Text_Wiki/Text/Wiki/Parse/Cowiki/",
            "lib/Text_Wiki/Text/Wiki/Parse/Mediawiki/"
        ],
        "psr-4": {
            "Horde\\Wicked\\": "/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Wicked\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/wicked",
        "bin/wicked-convert-to-utf8",
        "bin/wicked-mail-filter"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}
