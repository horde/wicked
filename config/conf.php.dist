// The email address   to which changes on pages should be mailed. Leave empty if you don't want   notification messages to be sent.
$conf['wicked']['notify_address'] = '';

// The email address   that should be used as the sender if guests are making changes.
$conf['wicked']['guest_address'] = '';

// Require users to enter a   change description?
$conf['wicked']['require_change_log'] = false;

// Require users to enter a   verification string with each message to protect against spam? (Requires   Horde 3.1)
// Options:
//   'false' - No
//   'true' - Yes
$conf['wicked']['captcha'] = 'false';

// How many minutes should pages be locked    for editing?
